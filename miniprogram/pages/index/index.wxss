/* 首页自定义顶栏（navigationStyle=custom）：左上角「我的」入口，固定常驻 */
.custom-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.custom-nav .nav-inner {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  position: relative;
}
.custom-nav .nav-title {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  pointer-events: none;
}
.custom-nav .nav-me {
  display: flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border: 1rpx solid #1a8cff;
  border-radius: 28rpx;
}
.custom-nav .nav-me-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 10rpx;
  background: #eee;
}
.custom-nav .nav-me-avatar image {
  width: 100%;
  height: 100%;
}
.custom-nav .nav-me-text {
  font-size: 26rpx;
  color: #1a8cff;
}

/* 首页背景图（后台「首页布局」可选设置）：
   背景层与遮罩层用 fixed + 负 z-index，铺在视口最底层——
   内容（顶栏/名片区/各板块）按常规流绘制，天然在其上方，不会被遮住。 */
.page { position: relative; }
.page-bg { position: fixed; left: 0; right: 0; top: 0; bottom: 0; width: 100%; height: 100%; z-index: -1; }
.page-bg-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: #000; z-index: -1; }

/* 有背景时的高端包装：卡片半透明浮起 + 圆角阴影，与深色背景形成层次 */
.has-bg .custom-nav { background: rgba(255,255,255,.94); border-bottom: none; }
.has-bg .section { background: rgba(255,255,255,.95); border-radius: 16rpx; margin: 20rpx 24rpx; padding: 28rpx; box-shadow: 0 6rpx 20rpx rgba(0,0,0,.10); }
.has-bg .nav-spacer + .section, .has-bg .section:first-of-type { margin-top: 20rpx; }
