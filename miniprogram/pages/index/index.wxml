<block wx:if="{{loading}}">
  <view class="loading">加载中…</view>
</block>

<block wx:elif="{{error}}">
  <view class="error-box">
    <view class="error-text">网络异常，加载失败</view>
    <button class="retry-btn" bindtap="reload">重新加载</button>
  </view>
</block>

<block wx:else>
  <view class="page {{bgImage ? 'has-bg' : ''}}">
    <!-- 首页背景图（可选，后台「首页布局」设置）：全屏铺底 + 遮罩压暗，
         白色内容卡片浮于其上，形成高端名片的层次感 -->
    <image wx:if="{{bgImage}}" class="page-bg" src="{{bgImage}}" mode="aspectFill" />
    <view wx:if="{{bgImage}}" class="page-bg-mask" style="opacity: {{bgMaskAlpha}}" />

    <!-- 自定义顶栏（navigationStyle=custom）：按设计稿融入浅蓝渐变背景，无白色底与居中标题，
         仅保留左上角「我的」入口，固定常驻 -->
    <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
      <view class="nav-inner">
        <view class="nav-me" bindtap="goMe">
          <view class="nav-me-avatar" wx:if="{{meAvatar}}"><image src="{{meAvatar}}" mode="aspectFill" /></view>
          <text class="nav-me-text">{{meName || '我的'}}</text>
        </view>
      </view>
    </view>
    <view class="nav-spacer" style="height: {{navHeight}}px;" />

    <block wx:if="{{disabled}}">
      <view class="disabled-tip">该员工名片已停用</view>
    </block>
    <block wx:elif="{{notFound}}">
      <view class="disabled-tip">员工不存在，请检查编号</view>
    </block>
    <block wx:else>
      <employee-card employee="{{employee}}" company="{{company}}" bind:entercase="onEnterCase" />
      <view class="section">
        <!-- 「公司简介」标题按设计稿叠在封面图左上角（见 company-video 组件），此处不再单列 -->
        <company-video channelId="{{profile.videoChannelId}}" backupMp4Url="{{profile.backupMp4Url}}" cover="{{profile.cover}}" />
        <view class="company-name">{{company.fullName}}</view>
        <text class="intro">{{profile.introText}}</text>
      </view>
      <block wx:for="{{homeOrder}}" wx:key="*this">
        <view wx:if="{{item === 'achievement'}}" id="sec-achievement" class="section">
          <view class="sec-head">
            <view class="sec-title">经典业绩</view>
            <view class="sec-link" bindtap="onEnterCase">案例进入</view>
          </view>
          <achievement-grid categories="{{categories}}" staffId="{{staffId}}" />
          <featured-projects featured="{{featured}}" staffId="{{staffId}}" />
        </view>
        <view wx:if="{{item === 'service'}}" class="section">
          <view class="sec-title">业务服务</view>
          <service-grid services="{{services}}" staffId="{{staffId}}" wx:if="{{services.length}}" />
          <view class="empty" wx:else>暂无服务内容</view>
        </view>
      </block>
      <view style="height: 120rpx;" />
      <action-bar employee="{{employee}}" company="{{company}}" staffId="{{staffId}}" />
    </block>
  </view>
</block>
