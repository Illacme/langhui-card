<view class="emp-card">
  <!-- 上半部：头像 + 姓名/职位 + 右上角企业 LOGO + 公司全称/案例进入 + 地址
       类名一律 ec- 前缀：组件 addGlobalClass 会吃到全局样式，
       通用名（cell/row/label…）会与「我的」页等全局类冲突泄漏样式 -->
  <view class="ec-head">
    <image class="avatar" src="{{employee.avatar}}" mode="aspectFill" lazy-load wx:if="{{employee.avatar}}" />
    <view class="avatar" wx:else />
    <view class="ec-info">
      <view class="ec-line1">
        <view class="ec-name">{{employee.name}}</view>
        <image class="logo" src="{{company.logo}}" mode="aspectFit" lazy-load wx:if="{{company.logo}}" />
      </view>
      <view class="ec-title" wx:if="{{employee.title}}">{{employee.title}}</view>
      <view class="ec-line3">
        <view class="ec-cname">{{company.fullName}}</view>
        <!-- 按设计稿为白底描边小药丸；跳转行为由页面通过 enter case 事件决定 -->
        <view class="case-btn" bindtap="onEnterCase">案例进入</view>
      </view>
      <view class="ec-addr" wx:if="{{company.address}}">{{company.address}}</view>
    </view>
  </view>

  <!-- 下半部：两列联系表。设计稿仅有上方一条通栏双色线（左段蓝+右段灰），
       手机行下方没有任何线（此前那条「半截线」是全局 .cell 边框泄漏所致，已修复） -->
  <view class="ec-rows">
    <view class="ec-rows-line" />
    <view class="ec-row">
      <view class="ec-cell"><text class="ec-label">手机</text><text class="ec-val">{{employee.phone}}</text></view>
      <view class="ec-cell"><text class="ec-label">座机</text><text class="ec-val">{{employee.landline || company.tel}}</text></view>
    </view>
    <view class="ec-row">
      <view class="ec-cell email"><text class="ec-label">邮箱</text><text class="ec-val">{{employee.email}}</text></view>
    </view>
  </view>
</view>
