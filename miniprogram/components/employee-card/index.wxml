<view class="emp-card">
  <!-- 上半部：头像 + 姓名/职位 + 右上角企业 LOGO + 公司全称/案例进入 + 地址 -->
  <view class="head">
    <image class="avatar" src="{{employee.avatar}}" mode="aspectFill" lazy-load wx:if="{{employee.avatar}}" />
    <view class="avatar" wx:else />
    <view class="info">
      <view class="line1">
        <view class="name">{{employee.name}}</view>
        <image class="logo" src="{{company.logo}}" mode="aspectFit" lazy-load wx:if="{{company.logo}}" />
      </view>
      <view class="title" wx:if="{{employee.title}}">{{employee.title}}</view>
      <view class="line3">
        <view class="cname">{{company.fullName}}</view>
        <!-- 按设计图为浅底描边小药丸；跳转行为由页面通过 enter case 事件决定 -->
        <view class="case-btn" bindtap="onEnterCase">案例进入</view>
      </view>
      <view class="addr" wx:if="{{company.address}}">{{company.address}}</view>
    </view>
  </view>

  <!-- 下半部：两列联系表。
       分隔线按设计稿用真实元素绘制（不依赖伪元素）：
       rows-line = 通栏双色线（左段蓝 + 右段灰），row-hline = 两行间仅左列的灰色半截线 -->
  <view class="rows">
    <view class="rows-line" />
    <view class="row">
      <view class="cell"><text class="label">手机</text><text class="val">{{employee.phone}}</text></view>
      <view class="cell"><text class="label">座机</text><text class="val">{{employee.landline || company.tel}}</text></view>
    </view>
    <view class="row-hline" />
    <view class="row">
      <view class="cell email"><text class="label">邮箱</text><text class="val">{{employee.email}}</text></view>
    </view>
  </view>
</view>
