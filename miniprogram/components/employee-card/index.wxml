<view class="emp-card">
  <view class="top">
    <image class="avatar" src="{{employee.avatar}}" mode="aspectFill" lazy-load wx:if="{{employee.avatar}}" />
    <view class="avatar" wx:else />
    <view class="info">
      <view class="name">{{employee.name}}</view>
      <view class="title">{{employee.title}}</view>
    </view>
    <!-- 右上角「案例进入」：按设计图仅保留一个实心蓝丸按钮。
         具体跳转行为由页面通过 enter case 事件决定（业绩区在首页则滚动，隐藏则跳分类列表）。 -->
    <view class="case-btn" bindtap="onEnterCase">案例进入</view>
  </view>
  <view class="company">
    <image class="logo" src="{{company.logo}}" mode="aspectFit" lazy-load wx:if="{{company.logo}}" />
    <view class="cname">{{company.fullName}}</view>
  </view>
  <view class="rows">
    <view class="row"><text class="label">地址</text><text>{{company.address}}</text></view>
    <view class="row"><text class="label">手机</text><text>{{employee.phone}}</text></view>
    <view class="row"><text class="label">座机</text><text>{{employee.landline || company.tel}}</text></view>
    <view class="row"><text class="label">邮箱</text><text>{{employee.email}}</text></view>
  </view>
</view>
