# docker-compose 变量（复制为 .env 后按需修改）。
# 注意：JWT_KEY / ADMIN_PASS / MYSQL_ROOT_PASSWORD 在 docker-compose.yml 中是「必填」变量
# （${VAR:?提示} 语法），未设置时 compose 直接报错、不会带默认值悄悄启动。

# MySQL：改成强随机值（openssl rand -base64 12）
MYSQL_ROOT_PASSWORD=langhui123

# 后端
# 上线前必改：openssl rand -base64 32
JWT_KEY=change-me
ADMIN_USER=admin
# 上线前必改：初始超管口令（openssl rand -base64 12），首登后还应在后台改密
ADMIN_PASS=admin123456

# HTTPS 生产必须设为 true（httpOnly Cookie 加 Secure 标志）；http 联调保持 false
COOKIE_SECURE=false
# 跨子域共享登录态才设（如前端 admin.xxx.com / 接口 api.xxx.com），一般留空
# COOKIE_DOMAIN=

# 数据库地址（仅「不用 docker-compose」的部署方式需要设；compose 内部已按服务名注入）。
# 驱动按 DSN 形态自动选择，同一个二进制不用换包：
#    MySQL（默认）：DB_DSN=root:密码@tcp(127.0.0.1:3306)/langhui?charset=utf8mb4&parseTime=true
#    SQLite 单机：DB_DSN=sqlite:///var/lib/langhui/langhui.db
# 用 SQLite 时不要执行 migrations/*.sql（MySQL 方言），表由服务启动时自动建；
# 边界：单机单进程、库文件必须在本地磁盘、备份用 VACUUM INTO。详见 docs/deploy-runbook.md 路径 D。
# DB_DSN=

# 可选（小程序码 / 对象存储 / CDN 刷新）
# WX_APPID=
# WX_APPSECRET=
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=
# OSS_ENDPOINT=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# CDN_ENABLED=false
# CDN_ACCESS_KEY_ID=
# CDN_ACCESS_KEY_SECRET=

# 可选：=1 开放 /metrics（Prometheus 抓取，建议仅内网可达）
# METRICS_ENABLED=false
