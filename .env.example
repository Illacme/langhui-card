# docker-compose 变量（复制为 .env 后按需修改）。
# 未提供 .env 时，docker-compose.yml 中已配置同款默认值。

# MySQL
MYSQL_ROOT_PASSWORD=langhui123

# 后端
JWT_KEY=change-me
ADMIN_USER=admin
ADMIN_PASS=admin123456

# HTTPS 生产必须设为 true（httpOnly Cookie 加 Secure 标志）；http 联调保持 false
COOKIE_SECURE=false
# 跨子域共享登录态才设（如前端 admin.xxx.com / 接口 api.xxx.com），一般留空
# COOKIE_DOMAIN=

# 可选（小程序码 / 对象存储 / CDN 刷新）
# WX_APPID=
# WX_APPSECRET=
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=
# OSS_ENDPOINT=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# CDN_ENABLED=false
# CDN_ACCESS_KEY_ID=
# CDN_ACCESS_KEY_SECRET=

# 可选：=1 开放 /metrics（Prometheus 抓取，建议仅内网可达）
# METRICS_ENABLED=false
