#!/bin/sh
# 推送前本地门禁：只要本次推送改了前端，就把类型检查先跑一遍。
#
# 为什么需要这个钩子：
#   CI 的「前端类型检查 (vue-tsc)」是和「前端 (Vue)」并列的独立 job，两者互不覆盖。
#   曾出现过单测全绿、类型检查却翻红的提交（守门测试用了 node:fs / process，
#   但 frontend 没有 @types/node），一直推到远端才被 CI 拦下。
#   这个钩子把 CI 里同一条命令提前到本地执行，结论一致、发现更早。
#
# 启用（每个克隆执行一次即可，钩子随仓库走，配置是本地的）：
#     git config core.hooksPath .githooks
#
# 临时跳过：
#     SKIP_TYPECHECK=1 git push        # 只跳过本钩子
#     git push --no-verify             # 跳过全部钩子
#
# 设计取舍：
#   · 只在本次推送涉及 frontend/ 变更时才跑——纯后端或文档提交直接放行，
#     否则每次推送固定多等两分钟，很快就会被 --no-verify 绕过去。
#   · 还没装依赖（新克隆）时只提示不阻断，避免本地环境问题挡住推送；
#     真正的门禁仍在 CI，钩子只是提前。
#   · 与 CI 用同一条命令（node 直调 vue-tsc，不经 npx），保证两边结论一致。

set -u

if [ "${SKIP_TYPECHECK:-0}" = "1" ]; then
  echo "[pre-push] 已按 SKIP_TYPECHECK=1 跳过前端类型检查"
  exit 0
fi

ZERO=0000000000000000000000000000000000000000
need_check=0

# git 通过标准输入给出每个待推的 ref：<local ref> <local sha> <remote ref> <remote sha>
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue

  # 删除远端分支（local_sha 全零）没有代码要检查
  [ "$local_sha" = "$ZERO" ] && continue

  if [ -n "${remote_sha:-}" ] && [ "$remote_sha" != "$ZERO" ]; then
    # 常规情况：远端已有的提交到本地头之间的差异，就是这次要推的内容
    base="$remote_sha"
  else
    # 新分支：改为从与 origin/main 的分叉点算起；连分叉点都找不到就放行，交给 CI
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
    [ -z "$base" ] && continue
  fi

  changed=$(git diff --name-only "$base" "$local_sha" 2>/dev/null || true)
  case "$changed" in
    *frontend/*) need_check=1 ;;
  esac
done

[ "$need_check" = "0" ] && exit 0

if [ ! -f frontend/node_modules/vue-tsc/bin/vue-tsc.js ]; then
  echo "[pre-push] 本次推送改了前端，但还没安装依赖，跳过类型检查。"
  echo "           建议先执行：cd frontend && npm ci"
  exit 0
fi

echo "[pre-push] 检测到前端改动，正在跑类型检查（vue-tsc --noEmit，约 2 分钟）……"
if ( cd frontend && node node_modules/vue-tsc/bin/vue-tsc.js --noEmit ); then
  echo "[pre-push] 类型检查通过。"
  exit 0
fi

cat <<'MSG'

[pre-push] 类型检查未通过，已阻止推送。

  · 按上面报的错误逐条修掉再提交。同样的错误在 CI 的
    「前端类型检查 (vue-tsc)」job 里也会失败，推上去只是晚一步发现问题。
  · 确实是草稿分支要备份，可以跳过：
        SKIP_TYPECHECK=1 git push
        git push --no-verify

MSG
exit 1
